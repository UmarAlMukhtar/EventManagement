DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=replace-with-your-database-password
DB_NAME=event_management
PORT=3000
# Use a long random value for new installations. Keep the old secret to accept
# unexpired HS256 tokens from Node during migration (then rotate it separately).
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
